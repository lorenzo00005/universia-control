# --- Postgres ---
POSTGRES_USER=rcm
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=rcm

# --- WAHA ---
WAHA_API_KEY=cambiar-esto-clave-larga
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=cambiar-esto

# --- Backend ---
WEBHOOK_SECRET=cambiar-esto-secreto-largo
JWT_SECRET=cambiar-esto-secreto-largo
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-esto
CORS_ORIGINS=http://localhost:5173

# --- Producción (solo con docker-compose.prod.yml) ---
CRM_DOMAIN=crm.tudominio.com
WAHA_DOMAIN=waha.tudominio.com
WAHA_BASIC_USER=admin
# Generar con: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'tu-clave'
# Importante: en .env los "$" del hash se escriben duplicados ($$) para que Compose no los interprete.
WAHA_BASIC_HASH=

# --- Meta Pixel / Conversions API (venta -> Purchase) ---
# ID del dataset/Pixel y token generado en el Administrador de eventos > Configuración > API de conversiones
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Para probar sin afectar campañas: código de "Probar eventos". Dejar vacío en producción.
META_TEST_EVENT_CODE=
META_DEFAULT_CURRENCY=ARS
# Dominios de tus landings (separados por coma) para que puedan llamar a /track/click
LANDING_ORIGINS=https://tulanding.com
